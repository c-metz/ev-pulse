[Unit]
Description=Run ev-static-refresh.service once a day
Documentation=file:///home/ev/ev-monitor/refresh_static.py

[Timer]
# 03:30 UTC -- after most upstream operators publish their daily static
# snapshot but before the dashboard sees significant traffic in CET.
OnCalendar=*-*-* 03:30:00 UTC
# Run on boot if we missed the schedule (e.g. server was down at 03:30).
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
